# Login to Azure
Connect-AzAccount

# Get all VMs
$vms = Get-AzVM

# Prepare data
$vmData = foreach ($vm in $vms) {
    $vmStatus = Get-AzVM -ResourceGroupName $vm.ResourceGroupName -Name $vm.Name -Status
    $vmSize = $vm.HardwareProfile.VmSize
    $vmInfo = Get-AzVMSize -Location $vm.Location | Where-Object { $_.Name -eq $vmSize }

    [PSCustomObject]@{
        Name           = $vm.Name
        ResourceGroup  = $vm.ResourceGroupName
        Location       = $vm.Location
        OS             = $vm.StorageProfile.OSDisk.OsType
        CPU            = $vmInfo.NumberOfCores
        RAM_GB         = [math]::Round($vmInfo.MemoryInMB / 1024, 2)
        Disk_OS        = $vm.StorageProfile.OSDisk.DiskSizeGB
        Disk_Data      = ($vm.StorageProfile.DataDisks | Measure-Object -Property DiskSizeGB -Sum).Sum
    }
}

# Export to CSV
$vmData | Export-Csv -Path "./AzureVMs.csv" -NoTypeInformation

Write-Output "Export complete: ./AzureVMs.csv"
