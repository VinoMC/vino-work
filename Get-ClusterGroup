# Collect VM info from the cluster
$vmData = Get-ClusterGroup | Where-Object {$_.GroupType -eq 'VirtualMachine'} | ForEach-Object {
    $vmName = $_.Name
    $ownerNode = $_.OwnerNode.Name
    $vm = Get-VM -Name $vmName -ErrorAction SilentlyContinue

    if ($vm) {
        # Get vCPU count
        $cpuCount = (Get-VMProcessor -VMName $vm.Name).Count

        # Get all VHD paths (joined with semicolon)
        $diskPaths = (Get-VMHardDiskDrive -VMName $vm.Name | Select-Object -ExpandProperty Path) -join "; "

        # Initialize OS Caption
        $osCaption = "Unavailable"

        # Attempt to query guest OS if VM is running
        if ($vm.State -eq 'Running') {
            try {
                $osCaption = Invoke-Command -VMName $vm.Name -ScriptBlock {
                    (Get-CimInstance -ClassName Win32_OperatingSystem).Caption
                } -ErrorAction Stop
            } catch {
                $osCaption = "Access Denied or Not Available"
            }
        }

        # Return custom object with all details
        [PSCustomObject]@{
            VMName          = $vm.Name
            State           = $vm.State
            HostNode        = $ownerNode
            CPUCount        = $cpuCount
            MemoryAssigned  = $vm.MemoryAssigned
            VHDPaths        = $diskPaths
            OperatingSystem = $osCaption
            Uptime          = $vm.Uptime
        }
    }
}

# Export to CSV
$vmData | Export-Csv -Path "C:\VMs_On_Cluster_Detailed.csv" -NoTypeInformation

Write-Output "✅ VM list exported to C:\VMs_On_Cluster_Detailed.csv"
